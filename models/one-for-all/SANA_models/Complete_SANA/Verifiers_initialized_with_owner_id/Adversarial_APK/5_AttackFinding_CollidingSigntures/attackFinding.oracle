#!/usr/bin/python3

import sys

MAX_RANK = 40
l = [[] for i in range (0, MAX_RANK) ]
lemma = sys.argv[1]

for line in sys.stdin.readlines():
  (num, goal) = line.split(": ",1)
    
  if lemma == "executable":
    if 'aenc' in goal: l[0].append(num)
    else: l[9].append(num)
  elif lemma == "unforgeability_freshness":
    if goal.startswith("!KU( sign(<hash"): l[1].append(num)
    elif goal.startswith("!Public_Key("): l[0].append(num)
    elif goal.startswith("!KU( ~sk"): l[0].append(num)
    elif goal.startswith("!KU( aenc("): l[2].append(num)
    elif goal.startswith("!KU( pk(~skA.2)"): l[10].append(num)
    elif "skA.2)" in goal: l[4].append(num)
    elif goal.startswith("!KU( validAgg("): l[6].append(num)
    elif goal.startswith("!KU( rogueAgg"): l[0].append(num)
    else: l[9].append(num)

  elif lemma == "unforgeability_freshness_honestOwner":
    if goal.startswith("!KU( sign(<hash"): l[0].append(num)
    elif goal.startswith("!Public_Key( P, pk(~skA.2)"): l[1].append(num)
    elif goal.startswith("!KU( aenc(") and "skA.2" in goal: l[2].append(num)
    elif goal.startswith("!KU( pk(~skA.2)"): l[10].append(num)
    elif "skA.2)" in goal: l[4].append(num)
    elif goal.startswith("!KU( ~sk"): l[5].append(num)
    elif goal.startswith("!KU( validAgg("): l[6].append(num)
    else: l[9].append(num)
  elif lemma == "completeness":
    if goal.startswith("!KU( sign(<hash"): l[1].append(num)
    elif goal.startswith("!Public_Key("): l[0].append(num)
    elif goal.startswith("!KU( ~sk"): l[0].append(num)
    elif goal.startswith("!KU( aenc("): l[2].append(num)
    # elif goal.startswith("!KU( pk(~skA.2)"): l[3].append(num)
    elif "skA.2)" in goal: l[4].append(num)
    elif goal.startswith("!KU( validAgg("): l[6].append(num)
    elif goal.startswith("!KU( singleZeroAgg"): l[0].append(num)
    else: l[9].append(num)
  else:
    exit(0)


for rank in l:
  for num in rank:
    print (num)