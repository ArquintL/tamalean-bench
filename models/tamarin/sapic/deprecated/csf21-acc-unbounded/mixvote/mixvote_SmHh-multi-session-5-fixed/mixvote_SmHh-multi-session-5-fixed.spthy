"(((Ex #i #j #k #l BB ba sid sskDa . ((Server(<sid, 'S2'>)@#i & (BB_rec(<sid, BB>, <'b', ba>)@#j & (BB_pskDs(<sid, BB>, <'spkD', pk(sskDa)>)@#k & (not((Ex bPrimeb . (ba = sg(bPrimeb, sskDa)))) & H2(sid)@#l)))))) & (not((Ex #i #j #k #l BB ba sid sskDa . ((Server(<sid, 'S1'>)@#i & (BB_rec(<sid, BB>, <'b', ba>)@#j & (BB_pskDs(<sid, BB>, <'spkD', pk(sskDa)>)@#k & (not((Ex bPrimeb . (ba = sg(bPrimeb, sskDa)))) & H2(sid)@#l))))))) & (not((Ex #i #j #k #l BB ba sid sskDa . ((Server(<sid, 'S3'>)@#i & (BB_rec(<sid, BB>, <'b', ba>)@#j & (BB_pskDs(<sid, BB>, <'spkD', pk(sskDa)>)@#k & (not((Ex bPrimeb . (ba = sg(bPrimeb, sskDa)))) & H2(sid)@#l))))))) & (not((Ex #i #j #k #l BB ba sid sskDa . ((Server(<sid, 'S4'>)@#i & (BB_rec(<sid, BB>, <'b', ba>)@#j & (BB_pskDs(<sid, BB>, <'spkD', pk(sskDa)>)@#k & (not((Ex bPrimeb . (ba = sg(bPrimeb, sskDa)))) & H2(sid)@#l))))))) & (not((Ex #i #j #k #l BB ba sid sskDa . ((Server(<sid, 'S5'>)@#i & (BB_rec(<sid, BB>, <'b', ba>)@#j & (BB_pskDs(<sid, BB>, <'spkD', pk(sskDa)>)@#k & (not((Ex bPrimeb . (ba = sg(bPrimeb, sskDa)))) & H2(sid)@#l))))))) & T))))) ==> (Ex #c0 . ((Corrupted('S2')@#c0 & T))))"

