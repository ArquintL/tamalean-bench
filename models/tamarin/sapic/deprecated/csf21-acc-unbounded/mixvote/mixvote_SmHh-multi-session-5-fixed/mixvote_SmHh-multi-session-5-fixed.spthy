  faultyS_strong_H4 accounts [cases] for
  "All sid H b #j b1. Verify(<sid, H>,b,b1 )@j ==> Ex BB #k. BB_rec(<sid, BB>,<'b', b >)@k"
   for parties <'S1', 'S2', 'S3', 'S4', 'S5'>

