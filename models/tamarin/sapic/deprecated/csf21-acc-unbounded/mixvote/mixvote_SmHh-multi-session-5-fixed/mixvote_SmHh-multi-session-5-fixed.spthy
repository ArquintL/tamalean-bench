lemma acc_TimelyP:
   faultyS_strong_H2 accounts [cases] for
   "All sid H b #i #j. Ballot(<sid, H>,b) @i & End(sid) @j ==> (  Ex BB #k . BB_rec(<sid, BB>,<'b', b >) @k & #i < #k & #k = #j)"
   for parties <'S1', 'S2', 'S3', 'S4', 'S5'>
*/

